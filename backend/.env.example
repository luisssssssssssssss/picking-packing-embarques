# Configuracion del backend para desarrollo local.
# Python lee backend/.env; las variables de entorno SQL_ tienen prioridad.
# Copiar a backend/.env; ese archivo local esta excluido de Git.
SQL_SERVER=localhost
SQL_DATABASE=PickingPackingEmbarques_Dev
SQL_AUTH_MODE=windows
SQL_DRIVER=ODBC Driver 18 for SQL Server
SQL_USERNAME=
SQL_PASSWORD=
SQL_ENCRYPT=true
# Solo para un SQL Server local de desarrollo con certificado propio.
SQL_TRUST_SERVER_CERTIFICATE=true

# Segundos: conexion (1-60) y consultas (1-300).
SQL_LOGIN_TIMEOUT=5
SQL_QUERY_TIMEOUT=10
